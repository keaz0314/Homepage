addEventListener(&#39;mouseout&#39;, function () {&#xA;        noteHover.style.display = &#39;none&#39;;&#xA;      });&#xA;    }&#xA;    paper.addEventListener(&#39;mousemove&#39;, function (e) {&#xA;      var x = e.offsetX&#xA;      const focusElX = e.offsetX + &#34;px&#34;&#xA;      var y = e.offsetY&#xA;      const focusElY = e.offsetY + &#34;px&#34;&#xA;      var rotateX = -4 / 9 * y + 20&#xA;      var rotateY = -2 / 45 * x + 20&#xA;      &#xA;      paper.style = &#39;transform : translateX(50px) scale(1.07) perspective(800px) rotateX(&#39; + rotateX / 2 + &#39;deg) rotateY(&#39; + rotateY / 2 + &#39;deg)&#39;&#xA;      paper.style.background = radial-gradient(&#xA;      circle 200px at ${focusElX} ${focusElY},&#xA;      rgba(255, 255, 255, 1) 30%,&#xA;      rgba(255, 255, 255, 0.7) 70%,&#xA;      rgba(225, 225, 225, 0.3) 100%&#xA;    })&#xA;    paper.addEventListener(&#39;mouseout&#39;, function () {&#xA;      paper.style = &#39;transform : rotate(0)&#39;&#xA;    });&#xA;  });&#xA;&lt;/script&gt;&#xA;&#xA;&lt;style&gt;&#xA;  .paper-listyes {&#xA;    max-height: 800px;&#xA;    padding-right : 60px;&#xA;    overflow-x: hidden;  &#xA;    overflow-y: auto;&#xA;    box-shadow: 10px 5px 5px rgba(0, 0, 0, 0.3);&#xA;  }&#xA;  .paper-listyes &gt; .paper {&#xA;  filter: none;  &#xA;}&#xA;&#xA;.paper, .paper-no-link {&#xA;    display: flex;&#xA;    border-bottom: 1px solid #ccc;&#xA;    border-radius: 20px;  &#xA;    padding-top: 10px;&#xA;    padding-bottom: 10px;&#xA;    position: relative;&#xA;    transition: transform 0.2s ease, box-shadow 0.8s ease;  &#xA;    background: linear-gradient(to bottom, #ffffff, white); 위에서 아래로 투명하게 변하는 그라데이션 배경색을 적용합니다&#xA;    z-index: 1;  &#xA;  }&#xA;&#xA;  .paper:hover {&#xA;    transition: transform 0.2s ease, box-shadow 0.4s ease;  &#xA;    transform: translateX(5px) scale(1.08);  &#xA;    z-index: 3;  &#xA;    box-shadow:&#xA;    inset 0 -3em 3em rgba(95, 127, 255, 0.5),&#xA;    0 0 0 0px white,&#xA;    0 0 0 0px white,&#xA;    0 0 0 0px white,&#xA;    0.3em 0.3em 1em rgba(255, 255, 255, 0.9);&#xA;  }&#xA;  &#xA;  .paper-no-link:hover {&#xA;    transition: transform 0.2s ease, box-shadow 0.4s ease;  &#xA;    transform: translateX(5px) scale(1.08);  &#xA;    z-index: 3;  &#xA;    box-shadow:&#xA;    inset 0 -3em 3em rgba(71, 71, 71, 0.5),&#xA;    0 0 0 0px white,&#xA;    0.3em 0.3em 1em rgba(255, 255, 255, 0.9);&#xA;  }&#xA;  &#xA;  .index {&#xA;    flex: 0 0 30px;&#xA;    margin-left: 10px;  &#xA;    font-size: 32px;&#xA;    display: flex;&#xA;    align-items: center;&#xA;    justify-content: center;&#xA;  }&#xA;  &#xA;  .paper-content {&#xA;    flex: 1;&#xA;    padding-left: 20px;&#xA;  }&#xA;  &#xA;  .note-hover {&#xA;    display: none;&#xA;    color: blue;&#xA;    font-weight: bold;&#xA;  }&#xA;  &#xA;  .paper-link {&#xA;    position: absolute;&#xA;    top: 0;&#xA;    left: 0;&#xA;    width: 100%;&#xA;    height: 100%;&#xA;    text-decoration: none;&#xA;    color: black;&#xA;  }&#xA;  .paper-link::after {&#xA;   &#xA;  display: none;&#xA;  position: absolute;&#xA;  background: #f9f9f9;&#xA;  border: 1px solid #ccc;&#xA;  padding: 5px;&#xA;  font-size: 18px;  &#xA;}&#xA;&#xA;.paper-link:hover::after {&#xA;  display: block;&#xA;  top: 30%;&#xA;  left: 1%;&#xA;  transform: translateX(-50%);&#xA;}&#xA;&lt;/style&gt;</description>
